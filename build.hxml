-L hashlink
-L tink_hxx

--class-path ../hlwgpu/haxe
# hlwindow's key, button and modifier types are ashui's input vocabulary
--class-path ../hlwindow/haxe
--class-path ../ash/haxelib/ash-future
--class-path ./haxe

# ashui's HXSL extension, before any shader is typed
--macro ashui.core.render.UiFramework.register()
