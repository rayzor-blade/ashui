package ashui.macro;

#if macro
import haxe.io.Path;
import haxe.macro.Compiler;
import haxe.macro.Context;
import sys.FileSystem;
import sys.io.File;

/**
	The page a web build runs in, from the library's `web/`: `index.html` and
	`ashui-host.mjs`, written beside the bytecode a build defined `wasm`
	makes, for the module `ash --build` is asked to write under the same name,
	`app.hl` for `app.wasm`. The page is the program's window, the canvas fills
	it, and it shows what is loading and what went wrong; the program's output is
	in the browser's console, and in the page with `?debug` in its address.

	An `index.html` already there that is not ashui's page or ash's generated
	one is the author's own, and stays as it is. Define `ashui_no_page` to
	stage neither file.
**/
class WebPage {
	static var registered = false;

	public static function stage():Void {
		if (registered || !Context.defined("wasm") || !Context.defined("hl") || Context.defined("hlc") || Context.defined("ashui_no_page"))
			return;
		registered = true;
		Context.onAfterGenerate(() -> {
			var output = Compiler.getOutput();
			var directory = Path.directory(output);
			var stem = Path.withoutExtension(Path.withoutDirectory(output));
			var web = Path.join([NativeInstall.root(), "web"]);
			if (!FileSystem.exists(Path.join([web, "index.html"]))) {
				Context.fatalError('ashui is missing its web page in $web; install the release Haxelib ZIP, or define ashui_no_page', Context.currentPos());
				return;
			}
			File.copy(Path.join([web, "ashui-host.mjs"]), Path.join([directory, "ashui-host.mjs"]));
			var page = Path.join([directory, "index.html"]);
			if (FileSystem.exists(page)) {
				var existing = File.getContent(page);
				if (existing.indexOf('name="ashui-module"') < 0 && existing.indexOf("generated by ash") < 0)
					return;
			}
			File.saveContent(page, StringTools.replace(StringTools.replace(File.getContent(Path.join([web, "index.html"])), "__ASHUI_MODULE__", stem + ".wasm"),
				"__ASHUI_TITLE__", stem));
		});
	}

	/**
		Copies the files in `directory`, relative to where the compiler runs, and in its folders, beside a web build's page,
		under `to`, which is the directory's own path when left out: `--macro ashui.macro.WebPage.copy("assets/audio", "audio")`.
		A page reads media by URL, so what `hlavi`'s `MediaPlayer` is to open, `Video` or `Audio` is given, must be served beside
		it; files the program reads itself are embedded instead (`ashui.core.Assets.embed`). A desktop build, which opens such
		files from where they are, copies nothing. Files whose names start with a dot are left out.
	**/
	public static function copy(directory:String, ?to:String):Void {
		if (!Context.defined("wasm") || !Context.defined("hl") || Context.defined("hlc"))
			return;
		if (!FileSystem.exists(directory) || !FileSystem.isDirectory(directory)) {
			Context.fatalError('WebPage.copy: $directory is not a directory', Context.currentPos());
			return;
		}
		var named = Path.normalize(to == null ? directory : to);
		Context.onAfterGenerate(() -> copyInto(directory, Path.join([Path.directory(Compiler.getOutput()), named])));
	}

	static function copyInto(from:String, into:String):Void {
		if (!FileSystem.exists(into))
			FileSystem.createDirectory(into);
		for (entry in FileSystem.readDirectory(from)) {
			if (entry.charAt(0) == ".")
				continue;
			var source = Path.join([from, entry]), destination = Path.join([into, entry]);
			if (FileSystem.isDirectory(source))
				copyInto(source, destination);
			else
				File.copy(source, destination);
		}
	}
}
#end
