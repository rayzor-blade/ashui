package ashui.ui;

import ashui.layout.Element;
import ashui.layout.LayoutTree;
import ashui.layout.Node;
import ashui.reactive.Owner;

/**
	Builds an element from typed props. The component exposes the element
	returned by `render` without adding a wrapper box.

	HXX creates `<my-card a={x}>...</my-card>` as a `MyCard` instance with
	props and children. Attributes are checked against `Props`. Props typed
	`IntoReactive<T>` track the dependencies read by their expressions.

	`render` runs in the component's owner scope. Removing the component
	cleans up everything created in that scope. Field initializers run first,
	so components can store signals in fields. `@:state var x:T = init`
	creates that signal automatically. See `ComponentBuilder`.
**/
@:autoBuild(ashui.ui.ComponentBuilder.build())
abstract class Component<Props> extends Element {
	/** Root components available for hot reload. Their renders were not called by another component. **/
	static final roots:Array<Component<Dynamic>> = [];

	/** The component currently executing `render`, or null outside a render. **/
	static var rendering:Null<Component<Dynamic>> = null;

	/** Maps each render owner to its component. **/
	static final hosts = new haxe.ds.ObjectMap<Owner, Component<Dynamic>>();

	/** Typed properties supplied when the component was created. **/
	public final props:Props;

	final children:Array<Element>;
	final parentOwner:Null<Owner>;
	var owner:Owner;

	/**
		The component that created this instance. For deferred children, such as
		new `<for>` items, uses the nearest component in the current owner ancestry.
	**/
	final builder:Null<Component<Dynamic>>;

	/** Child components in creation order. **/
	var built:Array<Component<Dynamic>> = [];

	/** Components from the previous render that have not yet transferred their state. **/
	var previous:Null<Array<Component<Dynamic>>> = null;

	public function new(props:Props, ?children:Array<Element>, ?tree:LayoutTree) {
		super(tree);
		this.props = props;
		this.children = children != null ? children : [];
		parentOwner = Owner.current;
		owner = new Owner(this.tree, parentOwner);
		hosts.set(owner, cast this);
		builder = rendering != null ? rendering : hostOf(parentOwner);
		// Under the owner this was built under, so it leaves the books with it.
		Owner.onCleanup(forget);
		if (builder == null) {
			node = build(owner);
			identify();
			roots.push(cast this);
			return;
		}
		builder.built.push(cast this);
		// Rendering again: take over the state of the component the last
		// render built in the same place, and match its children to ours.
		var old = builder.claim(Type.getClass(this));
		if (old != null) {
			__takeState(old);
			previous = old.built;
		}
		node = build(owner);
		identify();
		previous = null;
	}

	static function hostOf(owner:Null<Owner>):Null<Component<Dynamic>> {
		while (owner != null) {
			var host = hosts.get(owner);
			if (host != null)
				return host;
			owner = owner.parent;
		}
		return null;
	}

	/** Removes this component from the root, parent, and owner registries. **/
	function forget():Void {
		roots.remove(cast this);
		if (builder != null)
			builder.built.remove(cast this);
		hosts.remove(owner);
		node = null;
	}

	/**
		Registers the component tag for CSS type selectors, such as `counter-view`.
		Skips built-in HTML tag names to avoid applying their user-agent styles
		to unrelated components.
	**/
	function identify():Void {
		var name = tag(Type.getClass(this));
		if (node != null && !ashui.css.HtmlElements.has(name))
			ashui.css.Identity.register(tree, node, name);
	}

	/** Returns the HXX tag for a component class. For example, `CounterView` becomes `counter-view`. **/
	public static function tag(c:Class<Dynamic>):String {
		var name = Type.getClassName(c);
		name = name.substr(name.lastIndexOf(".") + 1);
		return ~/([a-z0-9])([A-Z])/g.map(name, r -> r.matched(1) + "-" + r.matched(2)).toLowerCase();
	}

	/** Returns and removes the first unclaimed component of class `c` from the previous render. **/
	function claim(c:Class<Dynamic>):Null<Component<Dynamic>> {
		if (previous == null)
			return null;
		for (i => old in previous)
			if (Type.getClass(old) == c) {
				previous.splice(i, 1);
				return old;
			}
		return null;
	}

	/** Transfers `@:state` signals from an old instance. Generated by `ComponentBuilder` for components with state fields. **/
	@:noCompletion function __takeState(old:Component<Dynamic>):Void {}

	/** Builds the element for this component. `props` and `children` are available during this call. **/
	abstract function render():Element;

	function build(into:Owner):Node {
		var outer = rendering;
		rendering = cast this;
		try {
			var built = into.run(render).node;
			rendering = outer;
			return built;
		} catch (e:haxe.Exception) {
			rendering = outer;
			throw e;
		}
	}

	/**
		Renders the component again and replaces the old element. Disposes resources
		from the previous render while preserving fields, including `@:state`.
		Child components of the same class inherit state in creation order,
		recursively through their children.
	**/
	public function rerender():Void {
		if (node == null)
			return;
		var next = new Owner(tree, parentOwner);
		hosts.set(next, cast this);
		var last = built;
		previous = last.copy();
		built = [];
		var fresh = try build(next) catch (e:haxe.Exception) {
			hosts.remove(next);
			next.dispose();
			built = last;
			previous = null;
			throw e;
		}
		previous = null;
		tree.replaceNode(node, fresh);
		hosts.remove(owner);
		owner.dispose();
		owner = next;
		node = fresh;
		identify();
	}

	override public function remove():Void {
		owner.dispose();
		forget();
	}

	/** Renders all root components again. Used by `HotReload`. **/
	@:noCompletion public static function rerenderRoots():Void {
		for (component in roots.copy())
			component.rerender();
	}
}
