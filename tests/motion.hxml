--class-path ../haxe
--class-path ../../hlwindow/haxe
# ash-simd for bulk byte work, on Ash
--class-path ../../ash/haxelib/ash-simd
-D ash_simd
--class-path .
-lib hashlink
-lib tink_hxx
# tink's own sources use deprecated metadata
-w -WDeprecated
# The CSS whose classes hxx accepts in class=
-D ashui_css=fixtures/css/smoke.css
-main Motion
-hl bin/motion.hl
# Templates as inline markup, with no hxx(...) around them
--macro ashui.ui.Markup.enable()
